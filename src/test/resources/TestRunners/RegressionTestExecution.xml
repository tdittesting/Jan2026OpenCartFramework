<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Trading App Test Regression Suite" verbose="4" thread-count="5" parallel="tests">
	<test name="Account Page Test_chrome">
		<parameter name ="browser" value = "chrome"/>
		<classes>
			<class name="com.qa.Trading.tests.AccountsPageTest" />
		</classes>
	</test>
	
		<test name="Account Page Test_Firefox">
		<parameter name ="browser" value = "firefox"/>
		<classes>
			<class name="com.qa.Trading.tests.AccountsPageTest" />
		</classes>
	</test>
		<test name="Account Page Test_Edge">
		<parameter name ="browser" value = "edge"/>
		<classes>
			<class name="com.qa.Trading.tests.AccountsPageTest" />
		</classes>
	</test>

	<test name="Login Page Test_chrome">
		<parameter name ="browser" value = "chrome"/>
		<classes>
			<class name="com.qa.Trading.tests.LoginPageTest" />
		</classes>
	</test>
		<test name="Login Page Test_firefox">
		<parameter name ="browser" value = "firefox"/>
		<classes>
			<class name="com.qa.Trading.tests.LoginPageTest" />
		</classes>
	</test>
		<test name="Login Page Test_edge">
		<parameter name ="browser" value = "edge"/>
		<classes>
			<class name="com.qa.Trading.tests.LoginPageTest" />
		</classes>
	</test>

	<test name="Product Info Test_chrome">
		<parameter name ="browser" value = "chrome"/>
		<classes>
			<class name="com.qa.Trading.tests.ProductInfoTest" />
		</classes>
	</test>
		<test name="Product Info Test_firefox">
		<parameter name ="browser" value = "firefox"/>
		<classes>
			<class name="com.qa.Trading.tests.ProductInfoTest" />
		</classes>
	</test>

	<test name="Product Info Test_edge">
		<parameter name ="browser" value = "edge"/>
		<classes>
			<class name="com.qa.Trading.tests.ProductInfoTest" />
		</classes>
	</test>


	<test name="Register Page Test">
		<classes>
			<class name="com.qa.Trading.tests.RegisterPageTest" />
		</classes>
	</test>

	<test name="Search Results Test">
		<classes>
			<class name="com.qa.Trading.tests.SearchResultsTest" />
		</classes>
	</test>

</suite>